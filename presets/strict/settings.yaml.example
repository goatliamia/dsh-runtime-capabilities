# Strict — 事后全开（guard + circuit + reconcile + investigate）+ 事实持久化。
# 高稳定性环境：更多确定性 authority，非"更聪明"。
# 注意：Strict may reduce agent freedom in exchange for stronger runtime enforcement.
agent-presets:
  default: strict
runtime-seam:
  preset: strict
  continuation: false
  authority: true
  circuitThreshold: 2
